---
import BaseLayout from '../layouts/BaseLayout.astro';
import { channels } from '../data/project';
const bugUrl = 'https://github.com/Kyrell-Einar/scaf.hub-/issues/new?template=bug_report.yml';
const ideaUrl = 'https://github.com/Kyrell-Einar/scaf.hub-/issues/new?template=feature_request.yml';
---
<BaseLayout title="Comunidade — SCAF Hub" description="Reporte bugs, envie sugestões e acesse os canais oficiais do SCAF.">
  <section class="page-shell page-hero"><div class="eyebrow">SCAF / Comunidade</div><h1 class="page-title">Comunidade sem perder os bugs no chat.</h1><p class="page-intro">Issues continuam como sistema oficial de triagem. Discord e canais sociais servem para conversa, showcase e contato com a equipe.</p></section>
  <section class="section"><div class="channel-grid"><article class="panel"><span class="tag blocked">BUG</span><h2>Reportar problema</h2><p>Plataforma, versão, dispositivo, passos, esperado e observado.</p><a class="button primary" href={bugUrl} target="_blank" rel="noopener noreferrer">Abrir relatório ↗</a></article><article class="panel"><span class="tag testing">IDEIA</span><h2>Enviar sugestão</h2><p>Explique a necessidade e como a ideia ajudaria builders ou jogadores.</p><a class="button primary" href={ideaUrl} target="_blank" rel="noopener noreferrer">Enviar sugestão ↗</a></article><article class="panel"><span class="tag">COMUNIDADE</span><h2>Discord oficial</h2><p>Conversa, showcase e contato com a equipe sem transformar chat em banco de bugs.</p><a class="button primary" href={channels.discord} target="_blank" rel="noopener noreferrer">Entrar no Discord ↗</a></article></div></section>
  <section class="section security-callout"><div class="panel"><span class="tag blocked">SEGURANÇA</span><h2>Vulnerabilidade sensível?</h2><p>Não publique credenciais, bypass de autorização ou dados privados em issue. Use o fluxo privado de segurança do GitHub quando disponível; se o botão não aparecer, entre no Discord e contate a equipe em mensagem privada.</p><div class="button-row"><a class="button" href={channels.security} target="_blank" rel="noopener noreferrer">Security Advisory ↗</a><a class="button" href={channels.discord} target="_blank" rel="noopener noreferrer">Discord ↗</a></div></div></section>
</BaseLayout>
