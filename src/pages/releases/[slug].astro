---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releases } from '../../data/releases';
import { to } from '../../lib/paths';
export function getStaticPaths() { return releases.map((release) => ({ params: { slug: release.slug }, props: { release } })); }
const { release } = Astro.props;
---
<BaseLayout title={`${release.title} v${release.version} — SCAF Hub`} description={release.summary}>
  <article class="page-shell article-page"><div class="eyebrow">{release.platform} / {release.state}</div><h1 class="page-title">{release.title} <span class="muted-title">v{release.version}</span></h1><p class="page-intro">{release.summary}</p><dl class="data-list"><div class="data-row"><dt>Publicado</dt><dd>{release.date ?? 'Data não confirmada'}</dd></div><div class="data-row"><dt>Compatibilidade</dt><dd>{release.compatibility}</dd></div><div class="data-row"><dt>Provedor</dt><dd>{release.provider}</dd></div></dl>{(release.localDownloadPath || release.downloadUrl || release.projectUrl) && <div class="button-row">{release.localDownloadPath && <a class="button primary" href={to(release.localDownloadPath)} download>Baixar .mcaddon</a>}{release.downloadUrl && <a class="button" href={release.downloadUrl} target="_blank" rel="noopener noreferrer">CurseForge ↗</a>}{release.projectUrl && release.projectUrl !== release.downloadUrl && <a class="button" href={release.projectUrl} target="_blank" rel="noopener noreferrer">Página do projeto ↗</a>}</div>}{release.packageReference && <section class="package-verification"><small>PACOTE VALIDADO NO HUB</small><strong>{release.packageReference.fileName}</strong><span>{release.packageReference.fileSize}</span><code>SHA-256 {release.packageReference.sha256}</code><p>{release.packageReference.note}</p></section>}<section class="prose"><h2>Mudanças</h2><ul>{release.changes.map((item: string) => <li>{item}</li>)}</ul><h2>Known issues</h2><ul>{release.knownIssues.map((item: string) => <li>{item}</li>)}</ul></section></article>
</BaseLayout>
