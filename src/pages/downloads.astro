---
import BaseLayout from '../layouts/BaseLayout.astro';
import { to } from '../lib/paths';
import { releases } from '../data/releases';
---
<BaseLayout title="Downloads — SCAF Hub" description="Download direto do SCAF Bedrock, link oficial e informações sobre builds Java.">
  <section class="page-shell page-hero"><div class="eyebrow">SCAF / Downloads</div><h1 class="page-title">A versão certa, sem adivinhação.</h1><p class="page-intro">A release Bedrock pública pode ser baixada direto pelo Hub. O CurseForge continua disponível como página oficial do projeto e as builds de teste seguem claramente separadas.</p></section>
  <section class="section release-stack">
    {releases.map((release) => <article class:list={['panel','release-card',{paper:release.state==='public'}]}><div><span class:list={['tag', release.state==='public'?'available':'testing']}>{release.state==='public'?'PÚBLICO':'TEST BUILD'}</span><h2>{release.title}</h2><p>{release.summary}</p><div class="release-meta"><span>{release.platform.toUpperCase()}</span><span>v{release.version}</span><span>{release.provider.toUpperCase()}</span></div>{release.packageReference && <div class="package-verification"><small>PACOTE V45 VALIDADO</small><strong>{release.packageReference.fileName}</strong><span>{release.packageReference.fileSize}</span><code>SHA-256 {release.packageReference.sha256}</code><p>{release.packageReference.note}</p></div>}<div class="button-row">{release.localDownloadPath && <a class="button primary" href={to(release.localDownloadPath)} download>Download direto (.mcaddon)</a>}{release.downloadUrl && <a class="button" href={release.downloadUrl} target="_blank" rel="noopener noreferrer">CurseForge ↗</a>}<a class="button" href={to(`releases/${release.slug}/`)}>Metadados da versão</a></div></div><strong>v{release.version}</strong></article>)}
  </section>
</BaseLayout>
