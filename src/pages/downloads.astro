---
import BaseLayout from '../layouts/BaseLayout.astro';
import { to } from '../lib/paths';
import { releases } from '../data/releases';
---
<BaseLayout title="Downloads — SCAF Hub" description="Download oficial do SCAF Bedrock e informações sobre builds Java.">
  <section class="page-shell page-hero"><div class="eyebrow">SCAF / Downloads</div><h1 class="page-title">A versão certa, sem adivinhação.</h1><p class="page-intro">A release Bedrock pública aponta para o provedor oficial. Builds de teste continuam claramente separadas.</p></section>
  <section class="section release-stack">
    {releases.map((release) => <article class:list={['panel','release-card',{paper:release.state==='public'}]}><div><span class:list={['tag', release.state==='public'?'available':'testing']}>{release.state==='public'?'PÚBLICO':'TEST BUILD'}</span><h2>{release.title}</h2><p>{release.summary}</p><div class="release-meta"><span>{release.platform.toUpperCase()}</span><span>v{release.version}</span><span>{release.provider.toUpperCase()}</span></div><div class="button-row">{release.downloadUrl && <a class="button primary" href={release.downloadUrl} target="_blank" rel="noopener noreferrer">Download oficial ↗</a>}<a class="button" href={to(`releases/${release.slug}/`)}>Metadados da versão</a></div></div><strong>v{release.version}</strong></article>)}
  </section>
</BaseLayout>
