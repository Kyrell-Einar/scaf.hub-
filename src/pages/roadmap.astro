---
import BaseLayout from '../layouts/BaseLayout.astro';
import { roadmap } from '../data/roadmap';
---
<BaseLayout title="Roadmap — SCAF Hub" description="Roadmap oficial do SCAF por estados de desenvolvimento.">
  <section class="page-shell page-hero"><div class="eyebrow">SCAF / Roadmap</div><h1 class="page-title">Estado real, não barra decorativa.</h1><p class="page-intro">Concluído, ativo, em teste, planejado ou quando estiver pronto.</p></section>
  <section class="section"><div class="roadmap-list">{roadmap.map((item) => <article class="road-row"><span class="n">{item.id}</span><h2>{item.title}</h2><p>{item.description}</p><b>{item.state}</b></article>)}</div></section>
</BaseLayout>
