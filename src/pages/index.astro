---
import BaseLayout from '../layouts/BaseLayout.astro';
import { to } from '../lib/paths';
import { project, channels } from '../data/project';
import { updates } from '../data/updates';
import { roadmap } from '../data/roadmap';
---
<BaseLayout title="SCAF Hub — Projeto, downloads e desenvolvimento" description="Hub oficial do projeto SCAF: download oficial, desenvolvimento, conteúdo, documentação e comunidade.">
  <section class="hero-wrap blueprint-zone">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Minecraft fan project · SCAF</div>
        <h1><span>SCAF</span><em>HUB.</em></h1>
        <p class="hero-lead">O ponto central do projeto: versão pública oficial, conteúdo real do addon, desenvolvimento documentado e suporte sem misturar release com test build.</p>
        <div class="button-row"><a class="button primary" href={channels.bedrockDownload} target="_blank" rel="noopener noreferrer">Baixar SCAF ↗</a><a class="button" href={to('development/')}>Ver desenvolvimento</a></div>
        <p class="provider-note">Download oficial hospedado no CurseForge por Mrsquirrel.</p>
      </div>
      <figure class="hero-media real-media"><img src={to('assets/media/build-interior.webp')} alt="Interior de pizzaria construído no Minecraft usando o SCAF" width="1100" height="495" fetchpriority="high" /><figcaption class="media-label"><span>BUILD PREVIEW / PIZZERIA</span><span>IN-GAME</span></figcaption></figure>
    </div>
    <div class="status-rail" aria-label="Resumo do estado do projeto">
      <div><small>Status do projeto</small><strong><span class="status-dot"></span>{project.status}</strong></div>
      <div><small>Bedrock público</small><strong>v{project.bedrock.version}</strong></div>
      <div><small>Java test build</small><strong>v{project.java.version}</strong></div>
      <div><small>Foco atual</small><strong>{project.focus}</strong></div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="section-head"><div><div class="eyebrow">Acesso rápido</div><h2>Entre pelo caminho certo.</h2></div><p>Seis áreas principais. O resto fica como detalhe, não como obstáculo no menu.</p></div>
    <div class="quick-grid">
      <a class="quick-card" data-index="01" href={to('downloads/')}><small>JOGAR</small><h3>Downloads</h3><p>Release pública, builds de teste e metadados.</p></a>
      <a class="quick-card" data-index="02" href={to('content/')}><small>VER</small><h3>Conteúdo</h3><p>Builds, sistemas, blocos e personagens em imagens reais.</p></a>
      <a class="quick-card" data-index="03" href={to('docs/')}><small>ENTENDER</small><h3>Documentação</h3><p>Instalação, compatibilidade, testes e referência técnica.</p></a>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Development pulse</div><h2>O que mudou, com data.</h2></div><a class="button" href={to('development/')}>Abrir desenvolvimento</a></div>
    <div class="updates-grid">
      {updates.slice(0,3).map((item, index) => <article class:list={['update-card', {featured:index===0}]}><small>{item.date ?? 'DATA NÃO CONFIRMADA'} · {item.area}</small><h3>{item.title}</h3><p>{item.summary}</p><a class="text-link" href={to(`updates/${item.slug}/`)}>Detalhes</a></article>)}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Built with SCAF</div><h2>O projeto aparece no jogo.</h2></div><a class="button" href={to('content/')}>Explorar conteúdo</a></div>
    <div class="gallery-strip">
      <figure class="gallery-tile"><img src={to('assets/media/security-office.webp')} alt="Sala de segurança construída no Minecraft com conteúdo do SCAF" width="960" height="540" loading="lazy" /><span>SECURITY OFFICE</span></figure>
      <figure class="gallery-tile"><img src={to('assets/media/backstage-workshop.webp')} alt="Backstage construído no Minecraft com conteúdo do SCAF" width="960" height="540" loading="lazy" /><span>BACKSTAGE</span></figure>
      <figure class="gallery-tile"><img src={to('assets/media/main-dining-room.webp')} alt="Salão principal construído no Minecraft com conteúdo do SCAF" width="960" height="540" loading="lazy" /><span>MAIN DINING</span></figure>
      <figure class="gallery-tile"><img src={to('assets/media/79682.webp')} alt="Pôsteres e itens decorativos do SCAF" width="684" height="1200" loading="lazy" /><span>CONTENT / POSTERS</span></figure>
      <figure class="gallery-tile"><img src={to('assets/media/carousel-clean.webp')} alt="Modelo do carrossel de FNaF 2 desenvolvido para o SCAF" width="960" height="853" loading="lazy" /><span>FNAF 2 / CAROUSEL</span></figure>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Roadmap</div><h2>Estado real, sem porcentagem inventada.</h2></div><a class="button" href={to('development/#roadmap')}>Roadmap completo</a></div>
    <div class="roadmap-list">{roadmap.slice(0,4).map((item) => <article class="road-row"><span class="n">{item.id}</span><h3>{item.title}</h3><p>{item.description}</p><b>{item.state}</b></article>)}</div>
  </section>
</BaseLayout>
