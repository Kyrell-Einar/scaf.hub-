---
import BaseLayout from '../layouts/BaseLayout.astro';
import { updates } from '../data/updates';
import { to } from '../lib/paths';
---
<BaseLayout title="Atualizações — SCAF Hub" description="Arquivo cronológico de atualizações do SCAF.">
  <section class="page-shell page-hero"><div class="eyebrow">SCAF / Newsroom</div><h1 class="page-title">Arquivo de atualizações.</h1><p class="page-intro">Este é o histórico detalhado. O resumo do produto fica em Desenvolvimento.</p></section>
  <section class="section"><div class="timeline-list">{updates.map((item) => <article class="timeline-item"><time datetime={item.date ?? undefined}>{item.date ?? 'Data não confirmada'}</time><div><h2>{item.title}</h2><p>{item.summary}</p><a class="text-link" href={to(`updates/${item.slug}/`)}>Abrir</a></div></article>)}</div></section>
</BaseLayout>
