---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedCopy } from '../../i18n';
import { localizedTo, to } from '../../lib/paths';
import { channels, project } from '../../data/project';
import { updates } from '../../data/updates';
import { roadmap } from '../../data/roadmap';
import { publicRelease } from '../../data/releases';
import type { Locale } from '../../lib/paths';

export function getStaticPaths() {
  const routes = ['', 'downloads', 'content', 'development', 'docs', 'community', 'about'];
  return (['en','es'] as const).flatMap((lang) => routes.map((path) => ({ params: { lang, path: path || undefined }, props: { lang, path } })));
}
const { lang, path } = Astro.props as { lang: 'en'|'es'; path: string };
const copy = localizedCopy[lang][(path || 'home') as keyof typeof localizedCopy.en];
const title = path ? `${copy.title} — SCAF Hub` : 'SCAF Hub';
---
<BaseLayout title={title} description={copy.lead}>
  <section class="page-shell page-hero blueprint-zone"><div class="eyebrow">{copy.eyebrow}</div><h1 class="page-title">{copy.title}</h1><p class="page-intro">{copy.lead}</p>
    {(!path || path === 'downloads') && <div class="button-row"><a class="button primary" href={to(publicRelease.localDownloadPath!)} download>{lang === 'en' ? 'Direct .mcaddon download' : 'Descarga directa .mcaddon'}</a><a class="button" href={channels.bedrockDownload} target="_blank" rel="noopener noreferrer">CurseForge ↗</a>{!path && <a class="button" href={localizedTo(lang as Locale, 'development')}>{lang === 'en' ? 'See development' : 'Ver desarrollo'}</a>}</div>}
  </section>
  {path === 'downloads' && <section class="section"><article class="panel paper"><div class="eyebrow">{lang === 'en' ? 'Verified public package' : 'Paquete público verificado'}</div><h2>{publicRelease.title} · v{publicRelease.version}</h2><p>{lang === 'en' ? 'This is the same Bedrock package referenced by the Portuguese Hub. The file path and verification data now come from a single release record, so translations cannot silently point to a different build.' : 'Este es el mismo paquete Bedrock usado por el Hub en portugués. La ruta del archivo y los datos de verificación ahora vienen de un único registro, evitando que una traducción apunte a otra build por error.'}</p>{publicRelease.packageReference && <div class="package-verification"><small>{lang === 'en' ? 'V45 PACKAGE VERIFIED' : 'PAQUETE V45 VERIFICADO'}</small><strong>{publicRelease.packageReference.fileName}</strong><span>{publicRelease.packageReference.fileSize}</span><code>SHA-256 {publicRelease.packageReference.sha256}</code></div>}<div class="button-row"><a class="button primary" href={to(publicRelease.localDownloadPath!)} download>{lang === 'en' ? 'Download verified .mcaddon' : 'Descargar .mcaddon verificado'}</a><a class="button" href={publicRelease.downloadUrl} target="_blank" rel="noopener noreferrer">CurseForge ↗</a></div></article></section>}
  {path === 'content' && <section class="section"><div class="content-grid"><article class="panel"><h2>{lang==='en'?'Real media':'Contenido real'}</h2><p>{lang==='en'?'The Portuguese content gallery contains the current in-game screenshots while this locale layer keeps navigation and core project information translated.':'La galería principal contiene las capturas actuales mientras esta capa mantiene traducida la navegación y la información esencial.'}</p><a class="button" href={localizedTo('pt','content')}>{lang==='en'?'Open visual gallery':'Abrir galería visual'}</a></article><article class="panel"><h2>{lang==='en'?'Current focus':'Foco actual'}</h2><p>{project.focus}</p></article></div></section>}
  {path === 'development' && <section class="section"><div class="timeline-list">{updates.slice(0,3).map((item) => <article class="timeline-item"><time>{item.date ?? '—'}</time><div><h2>{item.title}</h2><p>{item.summary}</p></div></article>)}</div><div class="roadmap-list localized-roadmap">{roadmap.slice(0,4).map((item) => <article class="road-row"><span class="n">{item.id}</span><h2>{item.title}</h2><p>{item.description}</p><b>{item.state}</b></article>)}</div></section>}
  {path === 'docs' && <section class="section prose"><h2>{lang==='en'?'Installation':'Instalación'}</h2><p>{lang==='en'?'Download the .mcaddon directly from the Hub or use the official CurseForge project, open it with Minecraft and verify compatibility before updating important worlds.':'Descarga el .mcaddon directamente desde el Hub o usa el proyecto oficial de CurseForge, ábrelo con Minecraft y verifica la compatibilidad antes de actualizar mundos importantes.'}</p><h2>{lang==='en'?'Test builds':'Builds de prueba'}</h2><p>{lang==='en'?'Java test builds are not public Bedrock releases. Always report the exact version when testing.':'Las builds de prueba de Java no son releases públicas de Bedrock. Informa siempre la versión exacta al probar.'}</p></section>}
  {path === 'community' && <section class="section"><div class="channel-grid"><article class="panel"><h2>GitHub Issues</h2><p>{lang==='en'?'Structured bug reports and suggestions.':'Bugs y sugerencias estructurados.'}</p><a class="button" href={channels.repository + '/issues'} target="_blank" rel="noopener noreferrer">GitHub ↗</a></article><article class="panel"><h2>Discord</h2><p>{lang==='en'?'Community, showcases and team contact.':'Comunidad, showcases y contacto con el equipo.'}</p><a class="button" href={channels.discord} target="_blank" rel="noopener noreferrer">Discord ↗</a></article></div></section>}
  {path === 'about' && <section class="section content-grid"><article class="panel paper"><h2>SCAF</h2><p>{copy.lead}</p></article><article class="panel"><h2>{lang==='en'?'Platforms':'Plataformas'}</h2><p>Bedrock · Java / NeoForge</p></article></section>}
</BaseLayout>
