---
import { galleryItems } from '../data/gallery';
import { to } from '../lib/paths';
---
<div class="gallery-filter-bar" role="group" aria-label="Filtrar galeria">
  <button class="filter-chip active" type="button" data-filter="all" aria-pressed="true">Todos</button>
  <button class="filter-chip" type="button" data-filter="build" aria-pressed="false">Builds</button>
  <button class="filter-chip" type="button" data-filter="content" aria-pressed="false">Conteúdo</button>
  <button class="filter-chip" type="button" data-filter="character" aria-pressed="false">Personagens</button>
  <button class="filter-chip" type="button" data-filter="development" aria-pressed="false">Desenvolvimento</button>
</div>
<p class="gallery-count" aria-live="polite"><span data-gallery-count>{galleryItems.length}</span> itens exibidos</p>
<div class="gallery-grid" data-gallery-grid>
  {galleryItems.map((item) => {
    const src = to(`assets/media/${item.media}`);
    return (
      <figure class:list={['gallery-card', { contain: item.fit === 'contain' }]} data-gallery-item data-category={item.category}>
        <button class="gallery-open" type="button" data-gallery-open data-src={src} data-alt={item.alt} data-title={item.title} aria-label={`Ampliar ${item.title}`}>
          <img src={src} alt={item.alt} width="960" height="540" loading="lazy" decoding="async" />
        </button>
        <figcaption><span>{item.label}</span><strong>{item.title}</strong></figcaption>
      </figure>
    );
  })}
</div>

<dialog class="gallery-lightbox" data-gallery-dialog aria-labelledby="gallery-lightbox-title">
  <div class="gallery-lightbox-shell">
    <button class="gallery-lightbox-close" type="button" data-gallery-close aria-label="Fechar imagem">×</button>
    <img data-gallery-dialog-image src="" alt="" />
    <div class="gallery-lightbox-caption"><span>GALERIA SCAF</span><strong id="gallery-lightbox-title" data-gallery-dialog-title></strong></div>
  </div>
</dialog>

<script is:inline>
  const filterButtons = [...document.querySelectorAll('[data-filter]')];
  const galleryCards = [...document.querySelectorAll('[data-gallery-item]')];
  const count = document.querySelector('[data-gallery-count]');

  filterButtons.forEach((button) => button.addEventListener('click', () => {
    const filter = button.getAttribute('data-filter');
    let visible = 0;
    filterButtons.forEach((candidate) => {
      const selected = candidate === button;
      candidate.classList.toggle('active', selected);
      candidate.setAttribute('aria-pressed', String(selected));
    });
    galleryCards.forEach((card) => {
      const show = filter === 'all' || card.getAttribute('data-category') === filter;
      card.toggleAttribute('hidden', !show);
      if (show) visible += 1;
    });
    if (count) count.textContent = String(visible);
  }));

  const dialog = document.querySelector('[data-gallery-dialog]');
  const dialogImage = dialog?.querySelector('[data-gallery-dialog-image]');
  const dialogTitle = dialog?.querySelector('[data-gallery-dialog-title]');

  document.querySelectorAll('[data-gallery-open]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(dialog instanceof HTMLDialogElement) || !(dialogImage instanceof HTMLImageElement)) return;
      dialogImage.src = button.getAttribute('data-src') || '';
      dialogImage.alt = button.getAttribute('data-alt') || '';
      if (dialogTitle) dialogTitle.textContent = button.getAttribute('data-title') || '';
      dialog.showModal();
    });
  });

  dialog?.querySelector('[data-gallery-close]')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
</script>
