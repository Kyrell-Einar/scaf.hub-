---
import BrandMark from './BrandMark.astro';
import { channels } from '../data/project';
import { localeFromPath, localizedTo } from '../lib/paths';
import { navLabels } from '../i18n';
const locale = localeFromPath(Astro.url.pathname);
const labels = navLabels[locale];
---
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand"><BrandMark /><div><strong>SCAF Hub</strong><p>A Shift at Freddy’s</p></div></div>
    <nav aria-label="Links do rodapé">
      <a href={localizedTo(locale, 'downloads')}>{labels.downloads}</a>
      <a href={localizedTo(locale, 'content')}>{labels.content}</a>
      <a href={localizedTo(locale, 'development')}>{labels.development}</a>
      <a href={localizedTo(locale, 'docs')}>{labels.docs}</a>
      <a href={localizedTo(locale, 'community')}>{labels.community}</a>
      <a href={localizedTo(locale, 'about')}>{labels.about}</a>
    </nav>
    <div class="footer-statement">
      <p>Projeto feito por fãs. Minecraft e Five Nights at Freddy’s pertencem aos seus respectivos detentores de direitos.</p>
      <p><a class="text-link" href={channels.repository} target="_blank" rel="noopener noreferrer">GitHub ↗</a> · <a class="text-link" href={channels.curseforge} target="_blank" rel="noopener noreferrer">CurseForge ↗</a> · <a class="text-link" href={channels.discord} target="_blank" rel="noopener noreferrer">Discord ↗</a></p>
    </div>
  </div>
</footer>
